# Copy this file to .env and fill in real values. Never commit .env.

# ---------------- App ----------------
ENVIRONMENT=production
BACKEND_URL=http://localhost:8000

# ---------------- Database ----------------
# SQLite is fine for <10 users. Swap for Postgres later by changing this string,
# e.g. postgresql+psycopg2://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./data/job_agent.db

# ---------------- OpenRouter / LLM ----------------
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,deepseek/deepseek-chat-v3-0324:free,google/gemma-3-27b-it:free,qwen/qwen-2.5-72b-instruct:free,mistralai/mistral-small-3.2-24b-instruct:free

# ---------------- Embeddings ----------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------------- Scraping ----------------
SCRAPER_HEADLESS=true
ENABLED_SOURCES=wuzzuf,bayt,tanqeeb,indeed,linkedin
# Optional: http://user:pass@host:port  (helps avoid IP-based blocking)
SCRAPER_PROXY=

# ---------------- Alerts / Scheduler ----------------
SCHEDULER_ENABLED=true
ALERT_INTERVAL_HOURS=6

# ---------------- SMTP (for Job Alerts email) ----------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
